<mujoco model="my_robot">
  <!-- Visual geoms: group 1, no collision.  Collision geoms: group 3 (hidden by default in the viewer). -->
  <default>
    <default class="visual">
      <geom group="1" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="3" rgba="1 0.5 0 0.4"/>
    </default>
  </default>

  <worldbody>
    <!-- Ground plane removed for Task 4: dr_mujoco provides its own floor (defining it twice crashes MuJoCo). -->
    <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
    <light directional="true" pos="0 0 10" dir="-0.5 0.1 -0.9" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" castshadow="true"/>

    <body name="base_body" pos="0 0 0.036">
      <joint type="free"/>
      <!-- solid cylinder r=0.174, h=0.02, m=0.2 -->
      <inertial pos="0 0 0" mass="0.2" diaginertia="1.52047e-3 1.52047e-3 3.0276e-3"/>
      <geom class="visual" type="cylinder" size="0.174 0.01" rgba="1 0.41 0.71 1"/>
      <geom class="collision" type="cylinder" size="0.174 0.01"/>

      <body name="head" pos="0.06 0 0.025">
        <!-- solid cube a=0.03, m=0.02 -->
        <inertial pos="0 0 0" mass="0.02" diaginertia="3e-6 3e-6 3e-6"/>
        <geom class="visual" type="box" size="0.015 0.015 0.015" rgba="0.13 0.7 0.3 1"/>
        <geom class="collision" type="box" size="0.015 0.015 0.015"/>
      </body>

      <body name="left_wheel" pos="0 0.175 0">
        <joint name="base_to_left_wheel" type="hinge" axis="0 1 0" frictionloss="0.02" armature="0.001"/>
        <!-- solid cylinder r=0.036, h=0.008, m=0.025; z-symmetric inertia rotated like the geom -->
        <inertial pos="0 0 0" euler="-90 0 0" mass="0.025" diaginertia="8.233e-6 8.233e-6 1.62e-5"/>
        <geom name="left_wheel_geom" class="visual" type="cylinder" size="0.036 0.004" euler="-90 0 0" rgba="0.05 0.05 0.05 1"/>
        <geom class="collision" type="cylinder" size="0.036 0.004" euler="-90 0 0"/>
        <geom class="visual" type="box" size="0.018 0.002 0.002" pos="0.018 0 0" rgba="1 1 1 1"/>
      </body>

      <body name="right_wheel" pos="0 -0.175 0">
        <joint name="base_to_right_wheel" type="hinge" axis="0 1 0" frictionloss="0.02" armature="0.001"/>
        <inertial pos="0 0 0" euler="-90 0 0" mass="0.025" diaginertia="8.233e-6 8.233e-6 1.62e-5"/>
        <geom name="right_wheel_geom" class="visual" type="cylinder" size="0.036 0.004" euler="-90 0 0" rgba="0.05 0.05 0.05 1"/>
        <geom class="collision" type="cylinder" size="0.036 0.004" euler="-90 0 0"/>
        <geom class="visual" type="box" size="0.018 0.002 0.002" pos="0.018 0 0" rgba="1 1 1 1"/>
      </body>

      <!-- swivel origin sits on the underside of the base (z = -0.01) -->
      <body name="caster_swivel" pos="-0.12 0 -0.01">
        <joint name="caster_swivel_joint" type="hinge" axis="0 0 1"/>
        <!-- solid cylinder r=0.01, h=0.01, m=0.015; geom is offset 5 mm down, so the COM is too -->
        <inertial pos="0 0 -0.005" mass="0.015" diaginertia="5e-7 5e-7 7.5e-7"/>
        <geom class="visual" type="cylinder" size="0.01 0.005" pos="0 0 -0.005" rgba="0.3 0.3 0.3 1"/>
        <geom class="collision" type="cylinder" size="0.01 0.005" pos="0 0 -0.005"/>

        <body name="caster_wheel" pos="0 0 -0.018">
          <joint name="caster_wheel_joint" type="hinge" axis="0 1 0"/>
          <!-- solid sphere r=0.008, m=0.01 -->
          <inertial pos="0 0 0" mass="0.01" diaginertia="2.56e-7 2.56e-7 2.56e-7"/>
          <geom class="visual" type="sphere" size="0.008" rgba="0.15 0.15 0.15 1"/>
          <geom class="collision" type="sphere" size="0.008"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Task 4: velocity motors on the two driven wheels.
       Names left_wheel_vel / right_wheel_vel are required by dr_mujoco's Python code. -->
  <actuator>
    <velocity name="left_wheel_vel"
              joint="base_to_left_wheel"
              kv="0.05"
              ctrllimited="true"
              ctrlrange="-10 10"/>
    <velocity name="right_wheel_vel"
              joint="base_to_right_wheel"
              kv="0.05"
              ctrllimited="true"
              ctrlrange="-10 10"/>
  </actuator>
</mujoco>
